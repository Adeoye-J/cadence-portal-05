# ---------------------------------------------------------------------------
# Cadence environment. Copy to .env.local for development.
# Every variable is validated at boot by lib/env-schema.ts. A blank value counts as unset. Missing or malformed
# values stop the server with a message naming the variable.
# ---------------------------------------------------------------------------

# REQUIRED. PostgreSQL connection string.
# Format: postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgres://cadence:cadence@localhost:5432/cadence

# REQUIRED. Session and magic-link signing secret, at least 32 characters.
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-32-plus-character-secret

# REQUIRED. Public origin of the app, no trailing slash.
APP_URL=http://localhost:3000

# OPTIONAL until transactional email is wired. Resend API key from
# https://resend.com/api-keys, and the verified sender address.
RESEND_API_KEY=
EMAIL_FROM=

# OPTIONAL until payments are wired. Paystack is primary; Flutterwave is fallback.
# Paystack keys: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=
# Flutterwave keys: https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_SECRET_KEY=

# OPTIONAL. Rate limiting and hot-data cache. Upstash REST credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# DEVELOPMENT ONLY. Set to 1 to act as the seeded client viewer without sign-in.
# Ignored when NODE_ENV is production. Remove once Better Auth is wired.
# DEV_DEMO_VIEWER=1

# Protects /api/jobs/notifications. Vercel cron sends it as a Bearer token. At least 16 characters.
# Generate with: openssl rand -base64 24
CRON_SECRET=

# Deliverable files. Cloudflare R2 needs an endpoint like https://<account>.r2.cloudflarestorage.com and
# region "auto". For local work, MinIO works with http://localhost:9000 and any region.
# Required before any file can be uploaded.
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Shown on the contact page. Leave blank until a support mailbox exists.
SUPPORT_EMAIL=

# Google sign-in. Create an OAuth client with the redirect URI {APP_URL}/api/auth/callback/google.
# Set both values or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
